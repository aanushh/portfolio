---
import { type CollectionEntry, render } from "astro:content"

import SinglePage from "@layouts/pages/SinglePage.astro"
import Prose from "@components/common/Prose.astro"
import WritingCard from "@components/section/writings/WritingCard.astro"
import { getPages, getWritings } from "@utils/getContent"

export async function getStaticPaths() {
  const pages = getPages()

  return (await pages).map((page) => ({
    params: { id: page.id === "home" ? undefined : page.id },
    props: { page },
  }))
}

interface Props {
  page: CollectionEntry<"pages">
}

const { page } = Astro.props
const { Content } = await render(page)

const isHome = page.id === "home"
let recentWritings: Awaited<ReturnType<typeof getWritings>> = []
if (isHome) {
  const allWritings = await getWritings()
  recentWritings = allWritings.slice(0, 2)
}
---

<SinglePage frontmatter={page}>
  <Content />
  {
    isHome && recentWritings.length > 0 && (
      <div class="not-prose mt-12">
        <div class="flex justify-between align-baseline">
          <h2 class="mb-6 text-lg font-semibold text-foreground">
            Recent Writings
          </h2>
          <a class="text-muted-foreground text-sm underline hover:text-foreground" href="/writings">See all</a>
        </div>

        <div class="flex flex-col gap-y-6 mb-4">
          {recentWritings.map((entry) => <WritingCard writingEntry={entry} />)}
        </div>
      </div>
    )
  }
</SinglePage>
