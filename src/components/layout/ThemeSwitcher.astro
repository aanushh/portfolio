---
import { Icon } from "astro-icon/components"
---

<button
  class="theme-toggle inline-flex size-8 items-center justify-center rounded-sm text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground"
  aria-label="Toggle theme"
>
  <Icon name="ph:sun" size={18} class="hidden dark:block" />
  <Icon name="ph:moon" size={18} class="block dark:hidden" />
</button>

<script>
  const init = () => {
    const saved = localStorage.getItem("theme")
    if (saved) {
      document.documentElement.classList.toggle("dark", saved === "dark")
    }

    document.querySelectorAll<HTMLElement>(".theme-toggle").forEach((toggle) => {
      if (toggle.dataset.init) return
      toggle.dataset.init = "true"
      toggle.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark")
        document.documentElement.classList.toggle("dark", !isDark)
        localStorage.setItem("theme", isDark ? "light" : "dark")
      })
    })
  }

  document.addEventListener("astro:page-load", init)
</script>
